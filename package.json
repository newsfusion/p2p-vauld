{
  "name": "p2p-extension",
  "version": "1.1.2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000",
  "scripts": {
    "dev": "vite build --watch",
    "dev:demo": "VITE_DEMO_MODE=true vite build --watch",
    "demo:service": "node scripts/demo-mock-service.mjs",
    "demo:login-cache:refresh": "node scripts/refresh-demo-login-cache.mjs",
    "icons:download": "node scripts/download-platform-icons.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "scan:sensitive": "node scripts/scan-sensitive-data.mjs",
    "build": "vite build --mode production",
    "demo:build": "VITE_DEMO_MODE=true vite build --mode production",
    "release:webstore": "node scripts/prepare-webstore-release.mjs",
    "validate:manifest": "node scripts/validate-extension-manifest.mjs",
    "validate:ci:gitlab": "node scripts/validate-gitlab-ci.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:cdp": "pnpm demo:build && playwright test --config=playwright.demo.config.ts --project=smoke tests/e2e/smoke/cdp-content-script.demo.test.ts",
    "test:e2e:service-worker": "pnpm demo:build && playwright test --config=playwright.demo.config.ts --project=smoke tests/e2e/smoke/service-worker-restart.demo.test.ts",
    "test:smoke:demo": "pnpm demo:build && playwright test --config=playwright.demo.config.ts --project=smoke",
    "test:smoke": "pnpm build && playwright test --project=smoke"
  },
  "dependencies": {
    "dexie": "^4.4.3",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.8.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@rolldown/plugin-babel": "0.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/chrome": "^0.1.43",
    "@types/node": "25.9.3",
    "@types/pngjs": "6.0.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "^6.0.2",
    "ajv": "8.18.0",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.1",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.2",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.0.16",
    "vite-plugin-web-extension": "^4.5.1",
    "vitest": "^4.1.10",
    "yaml": "2.8.3"
  }
}
